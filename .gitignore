# Build output. Everything generated lands under one of these: Loom's run/, the hand-rolled
# launcher's build/run<version>/, the downloaded client jars in build/minecraft/.
build/
.gradle/
run/

# The compile classpath is downloaded, not committed - Mojang's client jar is not redistributable.
*.class

# Editors and tooling.
.idea/
*.iml
.vscode/
__pycache__/
